# Optional: copy to .env. Existing shell variables take precedence.
# Relative paths are anchored at the repository, not the terminal's directory.
PORT=8765
VIETSTUDIO_DATA=./data
# Used only when the launcher starts its own Ollama instance.
OLLAMA_MODELS=./models/ollama
# VIETSTUDIO_OLLAMA_BIN=ollama
# Python 3.12 used by npm run setup (python on Windows, python3 elsewhere).
# PYTHON=python3
# Remote API remains disabled until explicitly enabled in the application.
# VIETSTUDIO_AI_KEY=
# auto: Docker CPU for OPUS on Intel macOS, native on other platforms.
VIETSTUDIO_OPUS_RUNTIME=auto
